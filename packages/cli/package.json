{
  "name": "@shaderbit/cli",
  "version": "0.1.0",
  "description": "Developer CLI tool for ShaderBit",
  "type": "module",
  "bin": {
    "shaderbit": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shaderbit/registry": "workspace:*",
    "commander": "^12.1.0",
    "picocolors": "^1.1.0",
    "prompts": "^2.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
